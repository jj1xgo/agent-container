#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    echo "usage: build-agent-handover-host /absolute/output/path" >&2
    exit 2
fi

OUTPUT=$1
case "$OUTPUT" in
    /*) ;;
    *) echo "output path must be absolute" >&2; exit 2 ;;
esac
if [ -e "$OUTPUT" ] || [ -L "$OUTPUT" ]; then
    echo "output path must not already exist" >&2
    exit 2
fi

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
umask 022
python3 -m zipapp "$REPO_ROOT/src" \
    --python "/usr/bin/env python3" \
    --main "agent_container.host_handover_cli:main" \
    --output "$OUTPUT"
chmod 755 "$OUTPUT"
