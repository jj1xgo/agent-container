#!/usr/bin/python3
"""Close the preserved mount fd before starting any agent-controlled process."""

import os
import re
import signal
import sys


arguments = sys.argv[1:]
if arguments and arguments[0] == "--registration-stop":
    arguments.pop(0)
    os.kill(os.getpid(), signal.SIGSTOP)
if arguments and arguments[0].startswith("--close-fd="):
    match = re.fullmatch(r"--close-fd=([0-9]+)", arguments.pop(0))
    if match is None or int(match.group(1)) < 3:
        raise SystemExit(64)
    try:
        os.close(int(match.group(1)))
    except OSError:
        raise SystemExit(70) from None
if not arguments or arguments.pop(0) != "--" or not arguments:
    raise SystemExit(64)
os.execvp(arguments[0], arguments)
