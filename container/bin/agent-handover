#!/bin/sh
set -eu

if [ "$#" -ne 3 ] || [ "$1" != "create" ] || [ "$2" != "--title" ]; then
    echo "usage: agent-handover create --title TITLE" >&2
    exit 2
fi

: "${AGENT_PROJECT_ID:?AGENT_PROJECT_ID is required}"
: "${AGENT_HANDOVER_BROKER_SOCKET:?AGENT_HANDOVER_BROKER_SOCKET is required}"
: "${AGENT_HANDOVER_BROKER_CAPABILITY:?AGENT_HANDOVER_BROKER_CAPABILITY is required}"

title=$3
exec python3 -m agent_container.handover_broker_client create --title="$title"
