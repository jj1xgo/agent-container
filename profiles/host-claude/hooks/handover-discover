#!/usr/bin/env python3
"""Claude Code SessionStart hook for host handover discovery.

Reads the hook payload from stdin, persists the Claude session ID for the
constrained host publisher, and reports only the latest handover path of
the registered project. The body is never injected; the session start is
never blocked.
"""

import json
import os
from pathlib import Path
import re
import subprocess
import sys


_SESSION_ID = re.compile(r"^[A-Za-z0-9._-]{1,128}$")
_PUBLISHER = Path(".local/libexec/agent-container/agent-handover-host")


def _persist_session(session_id: object) -> None:
    env_file = os.environ.get("CLAUDE_ENV_FILE")
    if not env_file or not isinstance(session_id, str):
        return
    if not _SESSION_ID.fullmatch(session_id):
        return
    with open(env_file, "a", encoding="utf-8") as stream:
        stream.write(f"export CLAUDE_SESSION_ID='{session_id}'\n")


def _discover(cwd: Path) -> str:
    publisher = Path.home() / _PUBLISHER
    if not publisher.is_file():
        return ""
    completed = subprocess.run(
        [str(publisher), "discover"],
        cwd=cwd,
        capture_output=True,
        text=True,
        timeout=2,
        check=False,
    )
    if completed.returncode != 0:
        return ""
    return completed.stdout.strip()


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        return 0
    if not isinstance(payload, dict):
        return 0
    if payload.get("hook_event_name") != "SessionStart":
        return 0
    _persist_session(payload.get("session_id"))
    cwd = payload.get("cwd")
    if not isinstance(cwd, str) or not cwd:
        return 0
    try:
        found = _discover(Path(cwd))
    except (OSError, subprocess.SubprocessError):
        return 0
    if not found:
        return 0
    context = (
        f"このprojectの最新handoverがあります: {found}\n"
        "別セッションの続きに必要な場合だけ本文を読み、現在のGit状態と照合してください。"
    )
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "SessionStart",
                    "additionalContext": context,
                }
            },
            ensure_ascii=False,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
